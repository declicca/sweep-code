<Project Sdk="Microsoft.NET.Sdk">

  <!-- Plan Sync on NinjaTrader 8: the indicator's network, files and logic run for real on the Mac against a Sweep test server
       (tests/ninjatrader_plan_test.py), with NinjaTrader's API and WPF stubbed. Never shipped. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <NoWarn>CS0649;CS0169;CS0414;CS0067;SYSLIB0014</NoWarn>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\SweepPlan.cs" Link="SweepPlan.cs" />
    <Compile Include="..\..\..\plan\PlanCore.cs" Link="PlanCore.cs" />
    <Compile Include="..\NinjaTraderStubs.cs" Link="NinjaTraderStubs.cs" />
    <Compile Include="WpfStubs.cs" />
    <Compile Include="Program.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SharpDX.Direct2D1" Version="4.2.0" />
    <PackageReference Include="SharpDX.Mathematics" Version="4.2.0" />
  </ItemGroup>

</Project>
