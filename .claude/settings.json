{
  "permissions": {
    "allow": [
      "Bash(git:*)",
      "Bash(php:*)",
      "Bash(python3:*)",
      "Bash(sqlite3:*)",
      "Bash(rsync --dry-run *)",
      "Bash(rsync -n *)",
      "Bash(rsync * --dry-run *)",
      "Bash(bash app/tests/run-all.sh:*)",
      "Bash(bash app/tools/build.sh:*)",
      "Bash(website/tools/qa/.venv/bin/python website/tools/qa/qa.py:*)",
      "Bash(tools/qa/.venv/bin/python tools/qa/qa.py:*)",
      "Bash(./deploy.sh app)",
      "Bash(./deploy.sh website)"
    ],
    "ask": [
      "Bash(./deploy.sh app --go)",
      "Bash(./deploy.sh website --go)",
      "Bash(ssh:*)"
    ],
    "deny": [
      "Read(./app/config.php)",
      "Read(./app/data/**)",
      "Read(**/sweep-private/**)",
      "Read(**/.env)"
    ]
  }
}
